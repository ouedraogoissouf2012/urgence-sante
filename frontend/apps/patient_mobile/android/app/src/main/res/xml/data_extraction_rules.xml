<?xml version="1.0" encoding="utf-8"?>
<!--
    Correctif #128 : la fiche médicale et le jeton de session sont sensibles
    (santé, identité) et ne doivent jamais quitter l'appareil, y compris via
    une sauvegarde cloud ou un transfert d'appareil à appareil. android:allowBackup
    (AndroidManifest.xml) est déjà à "false", ce qui désactive toute sauvegarde ;
    ces règles documentent explicitement l'exclusion et restent effectives si
    allowBackup venait un jour à changer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
