<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.urgencesante</groupId>
        <artifactId>backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>audit</artifactId>
    <name>Urgence Santé — Module Audit</name>
    <description>Traçabilité métier par consommation d'événements</description>

    <dependencies>
        <!-- Socle transverse partagé, sans métier. -->
        <dependency>
            <groupId>com.urgencesante</groupId>
            <artifactId>building-blocks</artifactId>
        </dependency>
        <!-- API publique consommée : l'événement AvailabilityUpdated (aucun accès à
             l'internal du module). Audit ne consomme QUE des événements (voir
             docs/architecture/MODULE_DEPENDENCIES.md) — jamais appelé directement. -->
        <dependency>
            <groupId>com.urgencesante</groupId>
            <artifactId>availability</artifactId>
        </dependency>

        <!-- Adaptateur de persistance de la trace d'audit. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Compteur d'échecs d'enregistrement (même usage que routing/OsrmRouteProvider) :
             sans reprise automatique (voir ADR-006), une alerte reste le seul filet. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Tests : domaine, application et adaptateurs (JUnit + Mockito). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
