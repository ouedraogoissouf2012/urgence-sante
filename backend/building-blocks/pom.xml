<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.urgencesante</groupId>
        <artifactId>backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>building-blocks</artifactId>
    <name>Urgence Santé — Building Blocks</name>
    <description>Briques transverses partagées, sans métier ni framework applicatif</description>

    <!--
      Aucune dépendance Spring applicative (JPA, contexte, injection) : ce
      module reste volontairement minimal et neutre. Exception ciblée et
      assumée : spring-web, pour les seuls types HttpStatus/ProblemDetail
      (RFC 9457) — aucun conteneur, aucune annotation, aucun bean (issue
      #151 : ExceptionHandlerSupport doit être appelable par tous les
      modules métier, donc vivre ici plutôt qu'en bootstrap qui dépend
      déjà d'eux).
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Tests unitaires uniquement (scope test) : le code de production reste neutre. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
